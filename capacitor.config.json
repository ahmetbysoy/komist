{
  "appId": "com.komist.terminal",
  "appName": "Komuta Merkezi",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": false,
    "minSdkVersion": 23,
    "targetSdkVersion": 34
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0a0e17",
      "showSpinner": false
    }
  }
}
